<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<style>
  @page { size: A4; margin: 16mm 14mm 20mm 14mm; }
  * { box-sizing: border-box; }
  html, body { background: #fff; color: #111; }
  body { margin: 0; font: 11pt/1.45 "Times New Roman", Georgia, serif; }
  .page { max-width: 190mm; margin: 0 auto; padding: 6mm 4mm 26mm; position: relative; z-index: 1; }
  .gov { text-align: center; border-bottom: 2px solid #111; padding-bottom: 2.5mm; margin-bottom: 4mm; }
  .gov::after { content: ""; display: block; border-bottom: 1px solid #111; margin-top: 1mm; }
  .gov .l1 { font-size: 9.5pt; letter-spacing: .18em; text-transform: uppercase; }
  .gov .l2 { font-size: 15pt; font-weight: bold; margin-top: .5mm; }
  .gov .l3 { font-size: 10pt; }
  h1 { font-size: 12.5pt; text-align: center; text-decoration: underline; margin: 4mm 0 3mm; letter-spacing: .03em; }
  h1 .sub { display: block; font-size: 10pt; font-weight: normal; text-decoration: none; margin-top: 1mm; }
  h2 { font-size: 11.5pt; margin: 6mm 0 2mm; border-bottom: 1px solid #999; padding-bottom: .8mm; }
  p { margin: 1.5mm 0; }
  table { width: 100%; border-collapse: collapse; margin: 2mm 0 3mm; font-size: 9pt; }
  th, td { border: 1px solid #555; padding: 1mm 1.5mm; vertical-align: top; text-align: left; }
  th { background: #eee; font-weight: bold; }
  td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .nw { white-space: nowrap; }
  .mono, td.mono { font-family: "Consolas", "Courier New", monospace; font-size: 8.5pt; }
  table.meta td { border: none; padding: .6mm 1.5mm; font-size: 10.5pt; }
  table.meta td:first-child { width: 34%; font-weight: bold; }
  .blank { display: inline-block; min-width: 45mm; border-bottom: 1px solid #111; }
  .muted { color: #444; }
  .small { font-size: 9pt; }
  .refs { font-size: 8pt; color: #444; }
  .refs a { color: inherit; }
  .tag { font-size: 8pt; color: #333; }
  .box { border: 1px solid #111; padding: 2mm 3mm; margin: 2mm 0; }
  .urgent { border: 2px solid #111; text-align: center; font-weight: bold; padding: 1mm; letter-spacing: .12em; margin: 2mm 0 3mm; }
  ol li, ul li { margin-bottom: 1mm; }
  .sig { margin-top: 14mm; display: flex; justify-content: space-between; break-inside: avoid; }
  .sig div { width: 46%; }
  .sig .right { text-align: right; }
  .watermark { position: fixed; top: 42%; left: 0; right: 0; text-align: center; font-size: 72pt; color: rgba(0,0,0,.06);
               transform: rotate(-28deg); pointer-events: none; z-index: 0; font-weight: bold; }
  .footer { position: fixed; bottom: 0; left: 0; right: 0; font-size: 7.5pt; color: #333; text-align: center;
            border-top: 1px solid #999; padding: 1.5mm 6mm; background: #fff; z-index: 2; }
  .toolbar { position: sticky; top: 0; background: #fff; padding: 2mm 0; text-align: right; z-index: 3; }
  .toolbar button { font: inherit; padding: 1mm 4mm; cursor: pointer; background: #fff; color: #111; border: 1px solid #111; }
  @media print { .toolbar { display: none; } .page { padding-top: 0; } tr { break-inside: avoid; } h2 { break-after: avoid; } }
</style>
</head>
<body>
<div class="watermark">DRAFT</div>
<div class="page">
  <div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button></div>
  <div class="gov">
    <div class="l1">MADHYA PRADESH POLICE · INDORE (M.P.)</div>
    <div class="l2">{{ ps }}</div>
    <div class="l3">Police Commissionerate, Indore · National Cyber Crime Helpline 1930</div>
  </div>
  {% block content %}{% endblock %}
</div>
<div class="footer">DRAFT generated by decision-support software for review by the Investigating Officer. Not a legal order until verified and signed.
  · Case {{ ev.case_id }} · Data SHA-256 {{ ev.data_sha256[:16] }}… · Facts fingerprint {{ ev.facts_sha256[:16] }}…</div>
</body>
</html>
