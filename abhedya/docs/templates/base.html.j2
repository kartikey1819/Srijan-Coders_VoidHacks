<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<style>
  @page { size: A4; margin: 16mm 14mm 20mm 14mm; }
  :root { --ink: #111; --muted: #555; --rule: #999; --soft: #f3f3f1; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: var(--ink); font: 10.5pt/1.45 "Times New Roman", Georgia, serif; }
  .page { max-width: 190mm; margin: 0 auto; padding: 8mm 0 24mm; }
  h1 { font-size: 15pt; text-align: center; margin: 0 0 2mm; letter-spacing: .02em; }
  h2 { font-size: 11.5pt; margin: 6mm 0 2mm; border-bottom: 1px solid var(--rule); padding-bottom: 1mm; }
  .sub { text-align: center; color: var(--muted); margin: 0 0 5mm; }
  table { width: 100%; border-collapse: collapse; margin: 2mm 0; font-size: 9pt; }
  th, td { border: 1px solid var(--rule); padding: 1.2mm 1.6mm; vertical-align: top; text-align: left; }
  th { background: var(--soft); font-weight: bold; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  .nw { white-space: nowrap; }
  td.mono { font-family: "Consolas", "Courier New", monospace; font-size: 8.5pt; }
  .kv td:first-child { width: 34%; background: var(--soft); font-weight: bold; }
  .muted { color: var(--muted); }
  .refs { font-size: 8pt; color: var(--muted); }
  .refs a { color: inherit; }
  .box { border: 1px solid var(--rule); min-height: 28mm; padding: 2mm; }
  .sign { margin-top: 12mm; display: flex; justify-content: space-between; }
  .warn { border-left: 3px solid #a00; padding: 1mm 3mm; margin: 2mm 0; }
  .watermark { position: fixed; top: 42%; left: 0; right: 0; text-align: center; font-size: 72pt; color: rgba(0,0,0,.06);
               transform: rotate(-28deg); pointer-events: none; z-index: 0; font-weight: bold; }
  .footer { position: fixed; bottom: 0; left: 0; right: 0; font-size: 7.5pt; color: var(--muted); text-align: center;
            border-top: 1px solid var(--rule); padding: 1.5mm 6mm; background: #fff; }
  .toolbar { position: sticky; top: 0; background: #fff; padding: 2mm 0; text-align: right; }
  .toolbar button { font: inherit; padding: 1mm 4mm; cursor: pointer; }
  @media print { .toolbar { display: none; } .page { padding-top: 0; } tr { break-inside: avoid; } }
</style>
</head>
<body>
<div class="watermark">DRAFT</div>
<div class="page">
  <div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button></div>
  {% block content %}{% endblock %}
</div>
<div class="footer">DRAFT generated by decision-support software for review by the Investigating Officer. Not a legal order until verified and signed.
  · Case {{ ev.case_id }} · Data SHA-256 {{ ev.data_sha256[:16] }}… · Facts fingerprint {{ ev.facts_sha256[:16] }}…</div>
</body>
</html>
